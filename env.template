# Socrata Real Estate MCP Server - Environment Configurations

# Optional: Your Socrata SODA API App Token (to bypass public rate limits)
# Get one at https://opendata.socrata.com/signup
# NOTE: You only need either SOCRATA_APP_TOKEN or SOCRATA_KEY_ID + SOCRATA_KEY_SECRET. You do not need both.
SOCRATA_APP_TOKEN=your_socrata_app_token_here

# Optional: Socrata API Key and Secret (required for Basic Authentication)
# Use these if you want to authenticate with your Developer API Key credentials instead of an App Token.
SOCRATA_KEY_ID=your_key_id_here
SOCRATA_KEY_SECRET=your_key_secret_here

# Optional: Email for User-Agent headers in geocoding API requests
USER_AGENT_EMAIL=your-email@example.com

# Optional: Cache expiration time in days for database neighborhood and entity lookups
CACHE_TTL_DAYS=7

